# Database Configuration
# For SQLite development, leave DB_HOST empty and unset DATABASE_URL.
# For MySQL, configure DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME or DATABASE_URL.
DB_HOST=
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=letlearn_db

# Security & JWT Configuration
SECRET_KEY=replace_with_a_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Public links and uploads
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
PUBLIC_FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=
MAX_UPLOAD_SIZE_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
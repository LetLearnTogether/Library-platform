# .env.example
# Copy this file to .env and replace placeholders with your actual local values

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=letlearn_db

# Security & JWT Configuration
SECRET_KEY=CHANGE_THIS_TO_YOUR_OWN_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Settings (Required by config.py)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
# Copy this file to .env on the deployment host. Never commit the populated file.
DOMAIN=library.example.org
ACME_EMAIL=operations@example.org

MYSQL_DATABASE=letlearn_db
MYSQL_USER=letlearn_app
MYSQL_PASSWORD=replace_with_a_unique_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_random_root_password

# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_at_least_32_random_characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

PUBLIC_API_BASE_URL=https://library.example.org/api/v1
PUBLIC_FRONTEND_URL=https://library.example.org
MAX_UPLOAD_SIZE_BYTES=10485760
